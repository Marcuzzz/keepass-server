KPS_HOST=0.0.0.0
KPS_PORT=8787
KPS_DATA_DIR=./data
# Created on first start when no user exists yet
KPS_ADMIN_USERNAME=admin
KPS_ADMIN_PASSWORD=change-me-please
KPS_MAX_UPLOAD_MB=50
KPS_KEEP_REVISIONS=50
KPS_KEEP_DAYS=30
KPS_TOKEN_TTL_DAYS=365
# Set when running behind a reverse proxy (uses X-Forwarded-For for login throttling)
KPS_TRUST_PROXY=false
# Optional direct TLS (otherwise terminate TLS in a reverse proxy)
# KPS_TLS_CERT=/path/fullchain.pem
# KPS_TLS_KEY=/path/privkey.pem
