{
  "name": "keepass-server",
  "version": "0.1.0",
  "description": "Self-hosted sync server for KeePass (.kdbx) databases: multi-user, revisions, conflict handling, offline-first clients",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "kps-server": "src/main.ts",
    "kps": "client/cli.ts"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/main.ts serve",
    "start": "node --disable-warning=ExperimentalWarning src/main.ts serve",
    "kps": "node --disable-warning=ExperimentalWarning client/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'test/**/*.test.ts'",
    "lint": "tsc --noEmit",
    "install-kps": "sh scripts/install-kps.sh"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  }
}
